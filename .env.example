GROQ_API_KEY=

# Different tasks use different Groq models: guardrail uses a
# safety/policy-tuned model, classifier is a single-shot, low-complexity
# decision that runs on every query so it defaults to a small/fast
# general model, and summarize/synthesize/qna need real reasoning
# quality over clinical content so they default to a larger model.
# Available model ids depend on your Groq account/key - check what's
# enabled for yours with the Groq console or `client.models.list()`.
# Override any of these independently if you want to.
GROQ_MODEL_GUARDRAIL=openai/gpt-oss-safeguard-20b
GROQ_MODEL_CLASSIFIER=openai/gpt-oss-20b
GROQ_MODEL_SUMMARIZE=openai/gpt-oss-120b
GROQ_MODEL_SYNTHESIZE=openai/gpt-oss-120b
GROQ_MODEL_QNA=openai/gpt-oss-120b
